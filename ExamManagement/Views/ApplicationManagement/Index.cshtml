@model ExamManagement.ViewModels.ApplicationManagementViewModel

@{
    ViewData["Title"] = "Application Management";
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Application Management</h2>
            <p class="text-muted mb-0">
                Manage student examination applications
            </p>
        </div>
        <div>
            <a asp-controller="Admin"
               asp-action="Index"class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Dashboard
            </a>
        </div>
    </div>

    <!-- FILTER -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get"asp-action="Index"class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Examination</label>
                    <select name="examId"class="form-select">
                        <option value="">All Examinations</option>
                        @foreach (var exam in Model.Exams)
                        {
                            <option value="@exam.Id"selected="@(Model.ExamId == exam.Id)">
                                @exam.ExamName
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Status</label>
                    <select name="status"class="form-select">
                        <option value="">All Status</option>
                        <option value="Draft"selected="@(Model.Status == "Draft")">Draft</option>
                        <option value="Submitted"selected="@(Model.Status == "Submitted")">Submitted</option>
                        <option value="Approved"selected="@(Model.Status == "Approved")">Approved</option>
                        <option value="Rejected"selected="@(Model.Status == "Rejected")">Rejected</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit"class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>
                        Apply Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- SUMMARY -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <small class="text-muted">Total</small>
                    <h3 class="fw-bold mb-0">@Model.Applications.Count</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <small class="text-muted">Submitted</small>
                    <h3 class="fw-bold mb-0">
                        @Model.Applications.Count(x => x.Status == "Submitted")
                    </h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <small class="text-muted">Approved</small>
                    <h3 class="fw-bold mb-0">
                        @Model.Applications.Count(x => x.Status == "Approved")
                    </h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <small class="text-muted">Rejected</small>
                    <h3 class="fw-bold mb-0">
                        @Model.Applications.Count(x => x.Status == "Rejected")
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <!-- APPLICATION TABLE -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-3">
                                Application No.
                            </th>
                            <th>
                                Student
                            </th>
                            <th>
                                Exam ID
                            </th>
                            <th>
                                Status
                            </th>
                            <th>
                                Hall Ticket
                            </th>
                            <th class="text-end px-3">
                                Action
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Applications.Any())
                        {
                            <tr>
                                <td colspan="6"class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No applications found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var application in Model.Applications)
                            {
                                <tr>
                                    <td class="px-3">
                                        <span class="fw-semibold">
                                            @application.ApplicationNumber
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">
                                            @application.FullName
                                        </div>
                                        <small class="text-muted">@application.Email</small>
                                    </td>
                                    <td>
                                        @application.ExamId
                                    </td>
                                    <td>
                                        @if (application.Status == "Submitted")
                                        {
                                            <span class="badge bg-warning text-dark">Submitted</span>
                                        }
                                        else if (application.Status == "Approved")
                                        {
                                            <span class="badge bg-success">Approved</span>
                                        }
                                        else if (application.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @application.Status
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(application.HallTicketNumber))
                                        {
                                            <span class="badge bg-primary">@application.HallTicketNumber</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Generated</span>
                                        }
                                    </td>
                                    <td class="text-end px-3">
                                        <a asp-action="Details"
                                           asp-route-id="@application.Id"class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>
                                            View
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>