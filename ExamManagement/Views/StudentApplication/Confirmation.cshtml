@model ExamManagement.Models.StudentApplication

@{
    ViewData["Title"] = "Application Submitted";
}

<div class="container py-5">
    <div class="card shadow-sm border-0 mx-auto"style="max-width: 700px;">
        <div class="card-body p-5 text-center">
            <div class="mb-4">
                <div class="display-4 text-success"> ✓ </div>
            </div>
            <h2 class="fw-bold mb-2">
                Application Submitted Successfully
            </h2>
            <p class="text-muted mb-4">
                Your application for
                <strong>@ViewBag.ExamName</strong>
                has been successfully submitted.
            </p>
            <div class="bg-light rounded p-4 mb-4">
                <div class="text-muted small mb-1">Application Number</div>
                <div class="fs-4 fw-bold">@Model.ApplicationNumber</div>
                <div class="mt-3">
                    <span class="badge bg-success">@Model.Status</span>
                </div>
            </div>
            <div class="alert alert-info text-start">
                <strong>Important:</strong>
                Please keep your application number safely for
                future reference.
            </div>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Student"
                asp-action="Index"class="btn btn-primary">
                    Go to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>