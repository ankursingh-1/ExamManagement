@model ExamManagement.ViewModels.StudentApplicationViewModel

@{
    ViewData["Title"] = "Edit Application";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Edit Application</h2>
        <p class="text-muted mb-0">@ViewBag.ExamName</p>
    </div>

    <!-- Form -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-pencil-square me-2"></i>
                Edit Basic Details
            </h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit"method="post">
                @Html.AntiForgeryToken()

                <!-- Application Id -->
                <input type="hidden"name="applicationId"value="@Context.Request.Query["applicationId"]" />

                <!-- Exam Id -->
                <input asp-for="ExamId"type="hidden" />

                <!-- Validation -->
                <div asp-validation-summary="ModelOnly"class="alert alert-danger"></div>

                <!-- Personal Details -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light">
                        <h6 class="fw-bold mb-0">
                            <i class="bi bi-person me-2 text-primary"></i>
                            Personal Details
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-4">

                            <!-- Full Name -->
                            <div class="col-md-6">
                                <label asp-for="FullName"class="form-label fw-semibold"></label>
                                <input asp-for="FullName"class="form-control" />
                                <span asp-validation-for="FullName"class="text-danger"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <label asp-for="Email"class="form-label fw-semibold"></label>
                                <input asp-for="Email"class="form-control" />
                                <span asp-validation-for="Email"class="text-danger"></span>
                            </div>

                            <!-- Mobile -->
                            <div class="col-md-6">
                                <label asp-for="Mobile"class="form-label fw-semibold"></label>
                                <input asp-for="Mobile"class="form-control" />
                                <span asp-validation-for="Mobile"class="text-danger"></span>
                            </div>

                            <!-- Date of Birth -->
                            <div class="col-md-6">
                                <label asp-for="DateOfBirth"class="form-label fw-semibold"></label>
                                <input asp-for="DateOfBirth"type="date"class="form-control" />
                                <span asp-validation-for="DateOfBirth"class="text-danger"></span>
                            </div>

                            <!-- Gender -->
                            <div class="col-md-6">
                                <label asp-for="Gender"class="form-label fw-semibold"></label>
                                <select asp-for="Gender"class="form-select">
                                    <option value="">Select Gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="Gender"class="text-danger"></span>
                            </div>

                            <!-- Father Name -->
                            <div class="col-md-6">
                                <label asp-for="FatherName"class="form-label fw-semibold"></label>
                                <input asp-for="FatherName"class="form-control" />
                                <span asp-validation-for="FatherName"class="text-danger"></span>
                            </div>

                            <!-- Mother Name -->
                            <div class="col-md-6">
                                <label asp-for="MotherName"class="form-label fw-semibold"></label>
                                <input asp-for="MotherName"class="form-control" />
                                <span asp-validation-for="MotherName"class="text-danger"></span>
                            </div>

                            <!-- Aadhaar -->
                            <div class="col-md-6">
                                <label asp-for="AadhaarNumber"class="form-label fw-semibold"></label>
                                <input asp-for="AadhaarNumber"class="form-control" />
                                <span asp-validation-for="AadhaarNumber"class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Address -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light">
                        <h6 class="fw-bold mb-0">
                            <i class="bi bi-geo-alt me-2 text-primary"></i>
                            Address Details
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-4">

                            <!-- Address -->
                            <div class="col-12">
                                <label asp-for="Address"class="form-label fw-semibold"></label>
                                <textarea asp-for="Address"class="form-control"rows="3"></textarea>
                                <span asp-validation-for="Address"class="text-danger"></span>
                            </div>

                            <!-- City -->
                            <div class="col-md-4">
                                <label asp-for="City"class="form-label fw-semibold"></label>
                                <input asp-for="City"class="form-control" />
                                <span asp-validation-for="City"class="text-danger"></span>
                            </div>

                            <!-- State -->
                            <div class="col-md-4">
                                <label asp-for="State"class="form-label fw-semibold"></label>
                                <input asp-for="State"class="form-control" />
                                <span asp-validation-for="State"class="text-danger"></span>
                            </div>

                            <!-- Pincode -->
                            <div class="col-md-4">
                                <label asp-for="Pincode"class="form-label fw-semibold"></label>
                                <input asp-for="Pincode"class="form-control" />
                                <span asp-validation-for="Pincode"class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between">
                    <a asp-action="Review"
                       asp-route-applicationId="@Context.Request.Query["applicationId"]"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Cancel
                    </a>
                    <button type="submit"class="btn btn-primary px-4">
                        <i class="bi bi-check-circle me-1"></i>
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}