@model ExamManagement.Models.StudentApplication

@{
    ViewData["Title"] = "Application Details";
    var payment = ViewBag.Payment
        as ExamManagement.Models.StudentApplicationPayment;
    var documents = ViewBag.Documents
        as List<ExamManagement.Models.StudentApplicationDocument>
        ?? new List<ExamManagement.Models.StudentApplicationDocument>();
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Application Details</h2>
            <p class="text-muted mb-0">@ViewBag.ExamName</p>
        </div>
        <button type="button"class="btn btn-outline-primary"onclick="window.print()">
            <i class="bi bi-printer me-2"></i>
            Print Application
        </button>
    </div>

    <!-- Application Summary -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <small class="text-muted">Application Number</small>
                    <div class="fw-bold fs-5"> @Model.ApplicationNumber </div>
                </div>
                <div class="col-md-4">
                    <small class="text-muted">Examination</small>
                    <div class="fw-bold fs-5"> @ViewBag.ExamName </div>
                </div>
                <div class="col-md-4">
                    <small class="text-muted">Status</small>
                    <div>
                        <span class="badge bg-success fs-6"> @Model.Status </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Personal Details -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-person me-2"></i>
                Personal Details
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <small class="text-muted">Full Name</small>
                    <div class="fw-semibold">@Model.FullName</div>
                </div>
                <div class="col-md-6">
                    <small class="text-muted">Email</small>
                    <div class="fw-semibold">@Model.Email</div>
                </div>
                <div class="col-md-6">
                    <small class="text-muted">Mobile</small>
                    <div class="fw-semibold">@Model.Mobile</div>
                </div>
                <div class="col-md-6">
                    <small class="text-muted">Date of Birth</small>
                    <div class="fw-semibold"> @Model.DateOfBirth </div>
                </div>
                <div class="col-md-6">
                    <small class="text-muted">Gender</small>
                    <div class="fw-semibold">@Model.Gender</div>
                </div>
                <div class="col-md-6">
                    <small class="text-muted">Father Name</small>
                    <div class="fw-semibold">@Model.FatherName</div>
                </div>
                <div class="col-md-6">
                    <small class="text-muted">Mother Name</small>
                    <div class="fw-semibold">@Model.MotherName</div>
                </div>
                <div class="col-md-6">
                    <small class="text-muted">Aadhaar Number</small>
                    <div class="fw-semibold">@Model.AadhaarNumber</div>
                </div>
                <div class="col-12">
                    <small class="text-muted">Address</small>
                    <div class="fw-semibold">
                        @Model.Address,
                        @Model.City,
                        @Model.State -
                        @Model.Pincode
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Qualification -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-mortarboard me-2"></i>
                Qualification Details
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <small class="text-muted">10th Qualification</small>
                    <div class="fw-semibold">
                        @(Model.Has10thQualification ? "Yes" : "No")
                    </div>
                </div>
                <div class="col-md-6">
                    <small class="text-muted">10th Percentage</small>
                    <div class="fw-semibold"> @Model.TenthPercentage </div>
                </div>
                <div class="col-md-6">
                    <small class="text-muted">12th Status</small>
                    <div class="fw-semibold"> @Model.TwelfthStatus </div>
                </div>
                <div class="col-md-6">
                    <small class="text-muted">12th Percentage</small>
                    <div class="fw-semibold"> @Model.TwelfthPercentage </div>
                </div>
                <div class="col-md-6">
                    <small class="text-muted">12th Board</small>
                    <div class="fw-semibold"> @Model.TwelfthBoard </div>
                </div>
                <div class="col-md-6">
                    <small class="text-muted">12th Passing Year</small>
                    <div class="fw-semibold"> @Model.TwelfthPassingYear </div>
                </div>

                <!-- Subjects -->
                <div class="col-12">
                    <small class="text-muted">Subjects</small>

                    <div class="row g-3 mt-1">

                        @if (ViewBag.SelectedSubjects != null &&
                                                ((IEnumerable<ExamManagement.Models.StudentApplicationSubject>)
                                                ViewBag.SelectedSubjects).Any())
                        {
                            foreach (var subject in
                            (IEnumerable<ExamManagement.Models.StudentApplicationSubject>)
                            ViewBag.SelectedSubjects)
                            {
                                <div class="col-md-3 col-sm-6">
                                    <div class="border rounded p-3 h-100 bg-light">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                                            <span class="fw-semibold">@subject.SubjectName</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12">
                                <div class="alert alert-warning mb-0">
                                    No subjects selected.
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (Model.HasGraduation)
                {
                    <div class="col-md-6">
                        <small class="text-muted">Graduation Course</small>
                        <div class="fw-semibold"> @Model.GraduationCourse </div>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted">Graduation Percentage</small>
                        <div class="fw-semibold"> @Model.GraduationPercentage </div>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted">Graduation Passing Year</small>
                        <div class="fw-semibold"> @Model.GraduationPassingYear </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Documents -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-file-earmark-text me-2"></i>
                Documents
            </h5>
        </div>
        <div class="card-body">
            @if (documents.Any())
            {
                <div class="row g-3">
                    @foreach (var document in documents)
                    {
                        <div class="col-md-6">
                            <div class="border rounded p-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold"> @document.DocumentType </div>
                                    <small class="text-muted"> @document.FileName </small>
                                </div>
                                <a asp-controller="StudentApplication"
                                   asp-action="Document"
                                   asp-route-documentId="@document.Id"target="_blank"class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i>
                                    View Document
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    No documents found.
                </div>
            }
        </div>
    </div>

    <!-- Payment -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-credit-card me-2"></i>
                Payment Details
            </h5>
        </div>
        <div class="card-body">
            @if (payment != null)
            {
                <div class="row g-3">
                    <div class="col-md-4">
                        <small class="text-muted">Payment Status</small>
                        <div>
                            <span class="badge bg-success"> @payment.Status </span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted">Amount</small>
                        <div class="fw-bold"> ₹@payment.Amount </div>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted">Payment Method</small>
                        <div class="fw-semibold"> @payment.PaymentMethod </div>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted">Payment ID</small>
                        <div class="fw-semibold"> @payment.PaymentId </div>
                    </div>

                    <div class="col-md-6">
                        <small class="text-muted">Paid On</small>
                        <div class="fw-semibold"> @payment.PaidAt </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    Payment details are not available.
                </div>
            }
        </div>
    </div>

    <!-- Actions -->
    <div class="d-flex justify-content-between mb-5">
        <a asp-controller="Student"
           asp-action="Index"class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>
            Dashboard
        </a>
        <button type="button"class="btn btn-primary"onclick="window.print()">
            <i class="bi bi-printer me-2"></i>
            Print Application
        </button>
    </div>
</div>