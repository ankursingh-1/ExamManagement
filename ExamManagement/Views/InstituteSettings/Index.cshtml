@model ExamManagement.Models.InstituteSetting

@{
    ViewData["Title"] = "Institute Settings";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Institute Settings</h2>
            <p class="text-muted mb-0">
                Manage institute information, contact details and logo.
            </p>
        </div>
        <a asp-controller="Admin"
           asp-action="Index"class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Dashboard
        </a>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button"class="btn-close"data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Validation -->
    <div asp-validation-summary="ModelOnly"class="alert alert-danger"></div>
    <form asp-controller="InstituteSettings"
          asp-action="Save"method="post"enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="row g-4">

            <!-- LEFT -->
            <div class="col-lg-8">

                <!-- Basic Information -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-building me-2"></i>
                            Institute Information
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">

                            <!-- Institute Name -->
                            <div class="col-md-8">
                                <label asp-for="InstituteName"class="form-label fw-semibold">
                                    Institute Name
                                </label>
                                <input asp-for="InstituteName"class="form-control"
                                       placeholder="Enter institute name" />
                                <span asp-validation-for="InstituteName"class="text-danger"></span>
                            </div>

                            <!-- Institute Code -->
                            <div class="col-md-4">
                                <label asp-for="InstituteCode"class="form-label fw-semibold">
                                    Institute Code
                                </label>
                                <input asp-for="InstituteCode"class="form-control"
                                       placeholder="Example: ABC001" />
                                <span asp-validation-for="InstituteCode"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- Address -->
                            <div class="col-12">
                                <label asp-for="Address"class="form-label fw-semibold">
                                    Address
                                </label>
                                <textarea asp-for="Address"class="form-control"rows="3"
                                          placeholder="Enter complete institute address">
                                </textarea>
                                <span asp-validation-for="Address"class="text-danger"></span>
                            </div>

                            <!-- City -->
                            <div class="col-md-4">
                                <label asp-for="City"class="form-label fw-semibold">City</label>
                                <input asp-for="City"class="form-control"placeholder="City" />
                            </div>

                            <!-- State -->
                            <div class="col-md-4">
                                <label asp-for="State"class="form-label fw-semibold">State</label>
                                <input asp-for="State"class="form-control"placeholder="State" />
                            </div>

                            <!-- Pin Code -->
                            <div class="col-md-4">
                                <label asp-for="PinCode"class="form-label fw-semibold">PIN Code</label>
                                <input asp-for="PinCode"class="form-control"placeholder="PIN Code" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contact Information -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="bi bi-telephone me-2 text-primary"></i>
                            Contact Information
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <!-- Phone -->
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber"class="form-label fw-semibold">Phone Number</label>
                                <input asp-for="PhoneNumber"class="form-control"placeholder="Institute phone number" />
                                <span asp-validation-for="PhoneNumber"class="text-danger"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <label asp-for="EmailAddress"class="form-label fw-semibold">
                                    Email Address
                                </label>
                                <input asp-for="EmailAddress"type="email"
                                       class="form-control"placeholder="Institute email" />
                                <span asp-validation-for="EmailAddress"class="text-danger"></span>
                            </div>

                            <!-- Website -->
                            <div class="col-md-12">
                                <label asp-for="Website"class="form-label fw-semibold">Website</label>
                                <input asp-for="Website"class="form-control"placeholder="https://example.com" />
                                <span asp-validation-for="Website"class="text-danger"></span>
                            </div>

                            <!-- Support Email -->
                            <div class="col-md-6">
                                <label asp-for="SupportEmail"class="form-label fw-semibold">Support Email</label>
                                <input asp-for="SupportEmail"type="email"class="form-control"
                                       placeholder="Support email" />
                                <span asp-validation-for="SupportEmail"class="text-danger"></span>
                            </div>

                            <!-- Support Phone -->
                            <div class="col-md-6">
                                <label asp-for="SupportPhone"class="form-label fw-semibold">
                                    Support Phone
                                </label>

                                <input asp-for="SupportPhone"class="form-control"placeholder="Support phone" />
                                <span asp-validation-for="SupportPhone"class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Save -->
                <div class="d-flex justify-content-end">
                    <button type="submit"class="btn btn-primary px-4">
                        <i class="bi bi-save me-2"></i>
                        Save Settings
                    </button>
                </div>
            </div>

            <!-- RIGHT -->
            <div class="col-lg-4">
                <!-- Logo -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="bi bi-image me-2 text-primary"></i>
                            Institute Logo
                        </h5>
                    </div>
                    <div class="card-body p-4 text-center">
                        @if (!string.IsNullOrWhiteSpace(Model.LogoPath))
                        {
                            <div class="mb-3">
                                <img src="@Model.LogoPath"alt="Institute Logo"
                                     class="img-fluid border rounded p-2"style="max-height:180px; max-width:100%;" />
                            </div>
                        }
                        else
                        {
                            <div class="border rounded p-5 mb-3 bg-light">
                                <i class="bi bi-building fs-1 text-muted"></i>
                                <div class="text-muted mt-2">No logo uploaded</div>
                            </div>
                        }

                        <label for="logoFile"class="form-label fw-semibold">Upload Logo</label>
                        <input type="file"name="logoFile"id="logoFile"
                               class="form-control"accept=".jpg,.jpeg,.png,.webp" />
                        <div class="form-text">
                            JPG, JPEG, PNG or WEBP.
                            Maximum 2 MB.
                        </div>
                        <span class="text-danger">@Html.ValidationMessage("logoFile")</span>
                    </div>
                </div>

                <!-- Information -->
                <div class="alert alert-info mt-4">
                    <div class="d-flex">
                        <i class="bi bi-info-circle me-2 mt-1"></i>
                        <div>
                            <strong>Note</strong>
                            <div class="small mt-1">
                                These institute details can be used
                                throughout the examination system,
                                including Hall Tickets and printed
                                documents.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}