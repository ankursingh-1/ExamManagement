@model ExamManagement.Models.Exam

@{
    ViewData["Title"] = "Exam Details";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Exam Details</h2>
            <p class="text-muted mb-0">
                Complete examination information and eligibility configuration.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit"asp-route-id="@Model.Id"class="btn btn-primary">
                <i class="bi bi-pencil"></i>Edit
            </a>

            <a asp-action="Index"class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i>Back
            </a>
        </div>
    </div>

    <!-- Basic Information -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-file-earmark-text"></i>Basic Information
            </h5>
        </div>
        <div class="card-body">
            <h4 class="mb-4">@Model.ExamName</h4>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <strong>Exam Code</strong>
                    <div>@Model.ExamCode</div>
                </div>
                <div class="col-md-4 mb-3">
                    <strong>Exam Type</strong>
                    <div>@Model.ExamType</div>
                </div>
                <div class="col-md-4 mb-3">
                    <strong>Status</strong>
                    <div>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </div>
                </div>
                <div class="col-md-12 mb-3">
                    <strong>Description</strong>
                    <div class="mt-1">
                        @(string.IsNullOrWhiteSpace(Model.Description)
                           ? "Not specified"
                           : Model.Description)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Application Schedule -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-calendar-event"></i>Application Schedule
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <strong>Application Start</strong>
                    <div>@Model.ApplicationStartDate.ToString("dd MMM yyyy")</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Application End</strong>
                    <div>@Model.ApplicationEndDate.ToString("dd MMM yyyy")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Examination Schedule -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-clock"></i>Examination Schedule
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <strong>Exam Date</strong>
                    <div>@Model.ExamDate.ToString("dd MMM yyyy")</div>
                </div>
                <div class="col-md-4 mb-3">
                    <strong>Start Time</strong>
                    <div>@Model.StartTime.ToString(@"hh\:mm")</div>
                </div>
                <div class="col-md-4 mb-3">
                    <strong>End Time</strong>
                    <div>@Model.EndTime.ToString(@"hh\:mm")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Application Fee -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-currency-rupee"></i>Application Fee
            </h5>
        </div>
        <div class="card-body">
            <h4 class="text-success mb-0">
                ₹@Model.ApplicationFee.ToString("N2")
            </h4>
        </div>
    </div>

    <!-- Eligibility Configuration -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-mortarboard"></i>Eligibility Configuration
            </h5>
        </div>
        <div class="card-body">
            @if (Model.EligibilityConfiguration != null)
            {

                <!-- Qualification -->
                <h6 class="fw-bold mb-3">Qualification Required</h6>
                <div class="mb-4">
                    @if (Model.EligibilityConfiguration.Requires10th)
                    {
                        <span class="badge bg-success me-2">10th</span>
                    }

                    @if (Model.EligibilityConfiguration.Requires12th)
                    {
                        <span class="badge bg-success me-2">12th</span>
                    }

                    @if (Model.EligibilityConfiguration.RequiresGraduation)
                    {
                        <span class="badge bg-success me-2">Graduation</span>
                    }

                    @if (!Model.EligibilityConfiguration.Requires10th &&
                                    !Model.EligibilityConfiguration.Requires12th &&
                                    !Model.EligibilityConfiguration.RequiresGraduation)
                    {
                        <span class="text-muted">No qualification specified.</span>
                    }
                </div>

                <!-- 12th Status -->
                <h6 class="fw-bold mb-3">12th Qualification Status</h6>
                <div class="mb-4">
                    @if (Model.EligibilityConfiguration.Allow12thPassed)
                    {
                        <span class="badge bg-success me-2">Passed</span>
                    }

                    @if (Model.EligibilityConfiguration.Allow12thAppearing)
                    {
                        <span class="badge bg-warning text-dark me-2">Appearing</span>
                    }

                    @if (Model.EligibilityConfiguration.Allow12thResultAwaited)
                    {
                        <span class="badge bg-info text-dark me-2">Result Awaited</span>
                    }

                    @if (!Model.EligibilityConfiguration.Allow12thPassed &&
                                    !Model.EligibilityConfiguration.Allow12thAppearing &&
                                    !Model.EligibilityConfiguration.Allow12thResultAwaited)
                    {
                        <span class="text-muted">Not specified.</span>
                    }

                </div>

                <!-- Minimum Percentage -->
                <h6 class="fw-bold mb-3">Minimum Percentage</h6>
                <div class="mb-4">

                    @if (Model.EligibilityConfiguration.MinimumPercentage.HasValue)
                    {
                        <span>@Model.EligibilityConfiguration.MinimumPercentage.Value.ToString("0.##")%</span>
                    }
                    else
                    {
                        <span class="text-muted">No minimum percentage specified.</span>
                    }
                </div>

                <!-- Required Subjects -->
                <h6 class="fw-bold mb-3">Required Subjects</h6>
                <div>
                    @if (Model.EligibilityConfiguration.RequiresPhysics)
                    {
                        <span class="badge bg-primary me-2">Physics</span>
                    }

                    @if (Model.EligibilityConfiguration.RequiresChemistry)
                    {
                        <span class="badge bg-primary me-2">Chemistry</span>
                    }

                    @if (Model.EligibilityConfiguration.RequiresBiology)
                    {
                        <span class="badge bg-primary me-2">Biology</span>
                    }

                    @if (Model.EligibilityConfiguration.RequiresMathematics)
                    {
                        <span class="badge bg-primary me-2">Mathematics</span>
                    }

                    @if (!Model.EligibilityConfiguration.RequiresPhysics &&
                                    !Model.EligibilityConfiguration.RequiresChemistry &&
                                    !Model.EligibilityConfiguration.RequiresBiology &&
                                    !Model.EligibilityConfiguration.RequiresMathematics)
                    {
                        <span class="text-muted">No specific subjects specified.</span>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    Eligibility configuration has not been created for this examination.
                </div>
            }
        </div>
    </div>

    <!-- Instructions -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-info-circle"></i>Examination Instructions
            </h5>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.Instructions))
            {
                <div style="white-space: pre-line;">@Model.Instructions</div>
            }
            else
            {
                <span class="text-muted">No instructions specified.</span>
            }
        </div>
    </div>

    <!-- Created / Updated -->
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <strong>Created At</strong>
                    <div>
                        @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
                    </div>
                </div>
                <div class="col-md-6">
                    <strong>Last Updated</strong>
                    <div>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            @Model.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
                        }
                        else
                        {
                            <span class="text-muted">Not updated</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>